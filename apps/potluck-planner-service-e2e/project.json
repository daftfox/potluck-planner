{
  "name": "potluck-planner-service-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["potluck-planner-service"],
  "targets": {
    "e2e": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{e2eProjectRoot}"],
      "dependsOn": [
        "potluck-planner-service:build",
        "potluck-planner-service:serve"
      ],
      "options": {
        "jestConfig": "apps/potluck-planner-service-e2e/jest.config.cts",
        "passWithNoTests": true
      }
    }
  }
}
